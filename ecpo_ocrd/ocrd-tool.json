{
  "git_url": "https://github.com/ssciwr/ecpo_ocrd",
  "tools": {
    "ocrd-regions-to-labelstudio": {
      "categories": [
        "Quality assurance"
      ],
      "description": "Export region segmentation to LabelStudio",
      "executable": "ocrd-regions-to-labelstudio",
      "input_file_grp_cardinality": 1,
      "output_file_grp_cardinality": 1,
      "parameters": {
        "predictions": {
          "default": false,
          "description": "Whether to mark as predictions (e.g. for manual correction)",
          "type": "boolean"
        }
      },
      "steps": [
        "evaluation/layout"
      ]
    },
    "ocrd-ecpo-segment": {
      "categories": [
        "Layout analysis"
      ],
      "description": "Refine Eynollah layout detection with PaddleOCR",
      "executable": "ocrd-ecpo-segment",
      "input_file_grp_cardinality": 1,
      "output_file_grp_cardinality": 1,
      "parameters": {
        "labels": {
          "default": ["text"],
          "description": "Which region labels to refine. Possible values include 'text', 'heading', 'image', 'artificial_boundary', and 'separator'. Use 'all' to select all labels.",
          "type": "array"
        }
      },
      "steps": [
        "layout/segmentation/region"
      ]
    },
    "ocrd-vlm-ocr": {
      "categories": [
        "Text recognition and optimization"
      ],
      "description": "Apply VLM-based OCR",
      "executable": "ocrd-vlm-ocr",
      "input_file_grp_cardinality": 1,
      "output_file_grp_cardinality": 1,
      "parameters": {
        "server": {
          "type": "string",
          "description": "The API-URL of an OpenAI-compatible inference server e.g. hosted locally with VLLM",
          "required": true
        },
        "model": {
          "type": "string",
          "description": "Model identifier for the inference server",
          "required": true
        },
        "apikey": {
          "type": "string",
          "description": "API key for the inference server",
          "default": "no-api-key-required"
        }
      },
      "steps": [
        "recognition/text-recognition"
      ]
    },
    "ocrd-yitizi-normalization": {
      "categories": [
        "Text recognition and optimization"
      ],
      "description": "Normalize chinese characters",
      "executable": "ocrd-yitizi-normalization",
      "input_file_grp_cardinality": 1,
      "output_file_grp_cardinality": 1,
      "parameters": {},
      "steps": [
        "recognition/post-correction"
      ]
    }
  },
  "version": "0.0.1"
}
